# System Configuration
APP_ENV=local
# Compose app containers connect to the db service on its internal MariaDB port.
# For a backend running outside Docker, use backend/.env.example instead.
MARIADB_USER=isms_user
MARIADB_PASSWORD=replace_with_database_password
MARIADB_ROOT_PASSWORD=replace_with_database_root_password
MARIADB_DB=isms_db
# At least 32 random characters, e.g. `openssl rand -hex 32`. Required outside local.
SECRET_KEY=replace_with_a_random_secret
# Initial "admin" password, used only when the database has no users yet.
# Required outside local; local falls back to Admin@123456.
ISMS_ADMIN_PASSWORD=

# Private attachment storage (MinIO). Use different random values per environment.
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_minio_secret_key_at_least_8_chars

# Product SSO intake (POR). JSON per product; see docs/POR-SSO-INTEGRATION.md.
POR_PRODUCTS=
# Portal reply notification email (worker). Leave empty to keep emails queued.
POR_SMTP_HOST=
POR_SMTP_FROM=
POR_SMTP_PORT=587
POR_SMTP_USER=
POR_SMTP_PASSWORD=
