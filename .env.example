# System Configuration
APP_ENV=local
# Compose app containers connect to the db service on its internal MariaDB port.
# For a backend running outside Docker, use backend/.env.example instead.
MARIADB_USER=isms_user
MARIADB_PASSWORD=replace_with_database_password
MARIADB_ROOT_PASSWORD=replace_with_database_root_password
MARIADB_DB=isms_db
SECRET_KEY=replace_with_a_random_secret
